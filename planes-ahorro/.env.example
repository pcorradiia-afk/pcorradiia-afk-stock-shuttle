# --- Supabase ---
# Copiá este archivo como ".env.local" y completá los valores de tu proyecto Supabase.
# Si dejás estas variables vacías, la app arranca en MODO DEMO (datos de ejemplo en memoria),
# ideal para probar la interfaz sin configurar nada.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (solo backend / scripts de administración). NUNCA exponer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
