# --- Supabase ---
# Copiá este archivo como ".env.local" y completá los valores de tu proyecto Supabase.
# Si dejás estas variables vacías, la app arranca en MODO DEMO (datos de ejemplo en memoria),
# ideal para probar la interfaz sin configurar nada.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (solo backend / scripts de administración). NUNCA exponer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp vía Twilio (Fase 4) ---
# NEXT_PUBLIC_WA_PROVIDER=twilio activa el envío real; sin esta variable, queda el simulado.
# Las TWILIO_* son SECRETAS (solo servidor): configurarlas en Vercel, nunca en el navegador.
NEXT_PUBLIC_WA_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
