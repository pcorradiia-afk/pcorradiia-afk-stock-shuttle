# ============================================================================
# Robot de sincronización Oliauto → Supabase. Copiá este archivo como `.env`
# para probar local. En producción, estos valores van como SECRETOS del runner
# (GitHub Actions / Supabase), NUNCA en el repo.
# ============================================================================

# --- Oliauto ---
OLIAUTO_URL=https://app.oliauto.com/login          # URL de la pantalla de login
OLIAUTO_USER=usuario-robot                          # usuario dedicado al robot
OLIAUTO_PASS=contraseña-secreta
OLIAUTO_HEADLESS=true                               # false para ver el navegador al ajustar selectores

# Selectores del login (ajustá si difieren en tu Oliauto)
OLIAUTO_SEL_USER=#usuario
OLIAUTO_SEL_PASS=#password
OLIAUTO_SEL_SUBMIT=button[type=submit]

# --- Navegación a cada reporte (COMPLETAR con tu paso a paso) ---
# URL directa del reporte (si existe) y selector del botón "Exportar a Excel".
# Reemplazá <REPORTE> por: BALANCE_GENERAL, BALANCE_PARCIAL, COMPOSICION, MAYOR.
OLIAUTO_SEL_EXPORT=                                 # selector de exportar por defecto (común a todos)
# OLIAUTO_URL_BALANCE_GENERAL=https://app.oliauto.com/reportes/balance
# OLIAUTO_EXPORT_BALANCE_GENERAL=#btn-exportar-excel
# OLIAUTO_URL_MAYOR=https://app.oliauto.com/reportes/mayor
# OLIAUTO_EXPORT_MAYOR=#btn-exportar-excel

# Qué reportes sincronizar (coma-separados). Por defecto: los cuatro.
OLIAUTO_REPORTES=balance_general,balance_parcial,composicion,mayor

# --- Supabase (usar la SERVICE ROLE key, solo del lado servidor) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# --- Empresa de esta corrida ---
EMPRESA_ID=e1                                       # e1..e5 según data/demo.ts

# Carpeta temporal de descargas
DESCARGAS_DIR=./descargas
