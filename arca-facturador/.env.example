# ==========================================================================
#  ARCA FACTURADOR · Archivo de ejemplo de variables de entorno
#  Copiá este archivo como `.env` y completá con tus datos.
#  El `.env` NO se commitea (está en .gitignore).
# ==========================================================================

# --------------------------------------------------------------------------
#  AMBIENTE DE ARCA
#  homo  = Homologación (pruebas). ← EMPEZÁ SIEMPRE ACÁ.
#  prod  = Producción (emite comprobantes REALES).
#  Producción está bloqueada salvo que además pongas ARCA_ALLOW_PROD=si.
# --------------------------------------------------------------------------
ARCA_ENV=homo
ARCA_ALLOW_PROD=no

# --------------------------------------------------------------------------
#  DATOS DEL EMISOR (vos, el monotributista)
# --------------------------------------------------------------------------
# CUIT del emisor, solo números (11 dígitos), sin guiones.
EMISOR_CUIT=20000000001

# Razón social / nombre que figura en el PDF.
EMISOR_RAZON_SOCIAL=Nombre Apellido

# Domicilio comercial (aparece en el PDF).
EMISOR_DOMICILIO=Calle 123, Ciudad, Provincia

# Punto de venta electrónico habilitado en ARCA (número, sin ceros a izquierda).
EMISOR_PUNTO_VENTA=1

# Condición del emisor frente al IVA (para el PDF). Monotributo por defecto.
EMISOR_CONDICION_IVA=Responsable Monotributo

# Ingresos Brutos / inicio de actividades (opcionales, solo para el PDF).
EMISOR_INGRESOS_BRUTOS=
EMISOR_INICIO_ACTIVIDADES=

# --------------------------------------------------------------------------
#  CERTIFICADO DIGITAL PARA WSAA
#  Ver el README (sección "Generar el certificado en ARCA") para obtenerlos.
#  Rutas relativas a la carpeta del proyecto (arca-facturador/).
# --------------------------------------------------------------------------
ARCA_CERT_PATH=certs/certificado.crt
ARCA_KEY_PATH=certs/clave-privada.key

# --------------------------------------------------------------------------
#  SERVIDOR LOCAL (formulario web)
# --------------------------------------------------------------------------
PORT=8787

# --------------------------------------------------------------------------
#  REDONDEO DE PRECIOS EN AJUSTES POR INFLACIÓN
#  peso   = redondea al peso ($1)
#  decena = redondea a la decena ($10)
#  centena= redondea a la centena ($100)
#  ninguno= sin redondeo (2 decimales)
# --------------------------------------------------------------------------
REDONDEO_DEFAULT=peso

# --------------------------------------------------------------------------
#  ENVÍO DE EMAIL (Microsoft 365) — se define en la Fase 5.
#  Dejá EMAIL_PROVIDER=log para registrar los envíos sin mandar nada real.
#  Opciones futuras: graph (Microsoft Graph API) | smtp (Office 365).
# --------------------------------------------------------------------------
EMAIL_PROVIDER=log
EMAIL_FROM=

# --- Microsoft Graph API (si EMAIL_PROVIDER=graph) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- SMTP Office 365 (si EMAIL_PROVIDER=smtp) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
