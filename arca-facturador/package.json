{
  "name": "arca-facturador",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generador de Facturas C (Monotributo) contra los web services de ARCA (ex-AFIP): WSAA + WSFEv1, PDF con QR y envio por email.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "node-forge": "^1.3.1",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/node-forge": "^1.3.11",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
