# =====================================================================
#  Configuración del puente de WhatsApp (Grupo Fiorasi)
#  Copiá este archivo como .env y completá los valores.
#  NUNCA subas el .env real al repositorio (ya está en .gitignore).
# =====================================================================

# --- Twilio (credenciales de la cuenta del grupo) ---
# Se obtienen en https://console.twilio.com  (Account SID + Auth Token)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-auth-token-secreto

# --- Validación de firma de Twilio ---
# En producción dejar en true: rechaza webhooks que no vengan firmados por Twilio.
# En desarrollo local con ngrok podés ponerlo en false para probar con curl.
TWILIO_VALIDAR_FIRMA=false

# --- Agente de IA (Claude) ---
# La IA es simulada en la Fase 1. Cuando quieras activarla de verdad,
# completá la API key y poné IA_ACTIVA=true.
IA_ACTIVA=false
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
IA_MODELO=claude-opus-4-8

# --- Persistencia (Supabase, opcional) ---
# Si NO completás esto, todo funciona igual pero en memoria (se pierde al reiniciar).
# Al completarlo, el sistema guarda en Supabase automáticamente.
# Es backend: va la SERVICE_ROLE key (secreta), NUNCA la anon del frontend.
# Las tablas se crean con whatsapp/supabase/schema.sql
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# --- Sandbox de Twilio (para la primera prueba real, sin aprobar plantillas) ---
# El número del Sandbox te lo da Twilio (Messaging -> Try it out -> Send a WhatsApp message).
# Esto mapea ese número a una marca/línea para que el bot responda en las pruebas.
SANDBOX_NUMERO=+14155238886
SANDBOX_EMPRESA=empresa_pedro_corradi
SANDBOX_LINEA=ventas

# --- Acceso al panel (clave simple) ---
# Si los dejás vacíos, el panel queda ABIERTO (sólo para probar).
# Completalos para que pida usuario + contraseña al entrar al /panel.
PANEL_USUARIO=admin
PANEL_CLAVE=pone-una-clave-fuerte

# --- Zona horaria por defecto del grupo (para horarios de atención) ---
TZ_DEFECTO=America/Argentina/Buenos_Aires
