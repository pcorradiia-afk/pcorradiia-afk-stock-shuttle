# =====================================================================
#  Configuración del puente de WhatsApp (Grupo Fiorasi)
#  Copiá este archivo como .env y completá los valores.
#  NUNCA subas el .env real al repositorio (ya está en .gitignore).
# =====================================================================

# --- Twilio (credenciales de la cuenta del grupo) ---
# Se obtienen en https://console.twilio.com  (Account SID + Auth Token)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-auth-token-secreto

# --- Validación de firma de Twilio ---
# En producción dejar en true: rechaza webhooks que no vengan firmados por Twilio.
# En desarrollo local con ngrok podés ponerlo en false para probar con curl.
TWILIO_VALIDAR_FIRMA=false

# --- Agente de IA (Claude) ---
# La IA es simulada en la Fase 1. Cuando quieras activarla de verdad,
# completá la API key y poné IA_ACTIVA=true.
IA_ACTIVA=false
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
IA_MODELO=claude-opus-4-8

# --- Zona horaria por defecto del grupo (para horarios de atención) ---
TZ_DEFECTO=America/Argentina/Buenos_Aires
